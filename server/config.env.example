# Copy to config.env for local development.
# In production (Render), set these in the dashboard — never commit real values.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/mantritraders

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Origin allowed to call this API (the deployed client URL)
CLIENT_URL=http://localhost:5173
